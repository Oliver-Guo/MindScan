# Google Gemini API Key（必填）
GEMINI_API_KEY=your-gemini-api-key-here

# 以下變數已在 docker-compose.yml 中設定預設值，如需覆蓋可取消註解
# NODE_ENV=production
# PORT=3001
# CORS_ORIGIN=http://localhost
# LOG_LEVEL=info

# DATABASE_URL 已在 docker-compose.yml 中設定（使用 Docker 內部主機名 'mysql'）
# 本機開發請在 backend/.env 中設定：DATABASE_URL=mysql://root:rootpass@localhost:3306/mind_scan
